{
  "name": "scale-video-editor",
  "productName": "Scale Video Editor",
  "version": "0.1.0",
  "description": "Chat with Claude Code or Codex and watch your video get made. A desktop editor built on FilmCraft and the Scale Video Toolkit.",
  "main": "main/main.js",
  "license": "MIT",
  "author": "Scale.gg",
  "repository": "https://github.com/MonarchLabsLLC/Scale-Video-Editor",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "gg.scale.videoeditor",
    "productName": "Scale Video Editor",
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MonarchLabsLLC",
        "repo": "Scale-Video-Editor",
        "releaseType": "draft"
      }
    ]
  }
}
