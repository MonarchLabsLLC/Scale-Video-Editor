{
  "name": "scale-video-editor",
  "productName": "Scale Video Editor",
  "version": "1.0.9",
  "description": "Chat with Claude Code or Codex and watch your video get made. A desktop editor built on FilmCraft and the Scale Video Toolkit.",
  "main": "main/main.js",
  "license": "MIT",
  "author": "Scale.gg",
  "repository": "https://github.com/MonarchLabsLLC/Scale-Video-Editor",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/brand-dev-app.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "gg.scale.videoeditor",
    "productName": "Scale Video Editor",
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "Scale-Video-Editor-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "Scale-Video-Editor-linux.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MonarchLabsLLC",
        "repo": "Scale-Video-Editor",
        "releaseType": "draft"
      }
    ],
    "dmg": {
      "artifactName": "Scale-Video-Editor-mac.dmg"
    },
    "nsis": {
      "artifactName": "Scale-Video-Editor-Setup.exe",
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
